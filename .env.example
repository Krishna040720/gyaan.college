# ===============================================
# GYAAN Platform Swappable Free AI Configuration
# ===============================================

# 1. LLM Provider (Free options: gemini_free | ollama_local)
LLM_PROVIDER=gemini_free
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# For offline local LLM via Ollama (zero API costs):
# LLM_PROVIDER=ollama_local
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:1b

# 2. Speech-to-Text (Free options: web_speech | whisper_local)
STT_PROVIDER=web_speech
WHISPER_MODEL=base
WHISPER_ENDPOINT=http://localhost:8000/api/voice/transcribe

# 3. Text-to-Speech (Free options: browser_speech | piper_local | edge_tts)
TTS_PROVIDER=browser_speech
PIPER_VOICE=en_IN-cmu_chetan-medium
EDGE_TTS_VOICE=en-IN-NeerjaNeural

# 4. Retrieval & Vector Search (Free options: sqlite_local | pgvector)
RETRIEVAL_PROVIDER=sqlite_local
DATABASE_URL=sqlite:///./gyaan_local.db

# 5. Vision / OCR (Free options: gemini_vision_free | tesseract_local)
VISION_PROVIDER=gemini_vision_free

# Backend Server Port (Default: 3001)
PORT=3001
NODE_PORT=3001

# Public Vite Variables (Accessible in Browser)
VITE_APP_NAME=GYAAN
VITE_API_BASE_URL=/api
VITE_STT_PROVIDER=web_speech
VITE_TTS_PROVIDER=browser_speech

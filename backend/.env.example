# GYAAN AI Backend Configuration Example
APP_NAME=GYAAN.AI Backend
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (supports SQLite for instant zero-dependency testing, or PostgreSQL)
DATABASE_URL=sqlite:///./gyaan_local.db

# AI & LLM Service Configuration (Free options: gemini_free | ollama_local)
LLM_PROVIDER=gemini_free
GEMINI_API_KEY=your_free_gemini_key_here
GEMINI_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b

# Speech Services (Free options: web_speech | whisper_local)
STT_PROVIDER=web_speech
WHISPER_MODEL=base

# Text-To-Speech (Free options: browser_speech | piper_local | edge_tts)
TTS_PROVIDER=browser_speech
PIPER_VOICE=en_IN-cmu_chetan-medium

# Retrieval & Vector DB (Free options: sqlite_local | pgvector)
RETRIEVAL_PROVIDER=sqlite_local

# Vision & OCR (Free options: gemini_vision_free | tesseract_local)
VISION_PROVIDER=gemini_vision_free

# Security & Child-Safety Compliance (DPDP Act 2023)
JWT_SECRET=gyaan_dev_secret_key_92837482910384759283749283
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PARENTAL_CONSENT_REQUIRED_BELOW_AGE=18
